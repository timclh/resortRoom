# Copy to .env for local runs of the AI concierge (`netlify dev`, `yarn eval:concierge`).
# On Netlify, set the same variables under Site configuration > Environment variables.
# Never commit the real file; .env is git-ignored.

ANTHROPIC_API_KEY=

# Optional
# CONCIERGE_MODEL=claude-haiku-5-5   # any model that supports structured outputs
# CONCIERGE_DAILY_LIMIT=300          # model calls per UTC day, across all visitors
# CONCIERGE_ENABLED=false            # kill switch: the page falls back to the filters
